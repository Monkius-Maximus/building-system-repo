{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildings-design-bible.local/schemas/regional-recipe.schema.json",
  "title": "Buildings Design Bible Regional Recipe",
  "description": "Contrato do BDB-007 para receitas localizadas com escopo, prevalencia e lacunas de catalogo auditaveis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_id",
    "display_name",
    "description",
    "status",
    "recipe_kind",
    "scope",
    "activation",
    "prevalence",
    "family_diversity",
    "family_rules",
    "deferred_features",
    "knowledge",
    "limitations"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "recipe_id": {"type": "string", "pattern": "^RCP_[A-Z0-9_]+$"},
    "display_name": {"type": "string", "minLength": 3},
    "description": {"type": "string", "minLength": 20},
    "status": {"enum": ["partial", "researched", "validated", "deprecated"]},
    "recipe_kind": {"enum": ["documented_corpus", "regional_distribution"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_anchor_ids",
        "geography",
        "archetype_ids",
        "construction_periods",
        "cultural_variants",
        "corpus_label",
        "basis_refs"
      ],
      "properties": {
        "context_anchor_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^CTX_[A-Z0-9_]+$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "geography": {"$ref": "#/$defs/geography"},
        "archetype_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^BLD_[A-Z]{3}_[A-Z0-9_]+$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "construction_periods": {"$ref": "#/$defs/nonempty_strings"},
        "cultural_variants": {"$ref": "#/$defs/nonempty_strings"},
        "corpus_label": {"type": "string", "minLength": 10},
        "basis_refs": {"$ref": "#/$defs/basis_refs"}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "regional_sampling_allowed",
        "requires_explicit_corpus_opt_in",
        "blocking_codes"
      ],
      "properties": {
        "state": {"enum": ["active", "corpus_limited", "blocked", "deprecated"]},
        "regional_sampling_allowed": {"type": "boolean"},
        "requires_explicit_corpus_opt_in": {"type": "boolean"},
        "blocking_codes": {"$ref": "#/$defs/diagnostic_codes"}
      }
    },
    "prevalence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_level",
        "denominator_status",
        "unit",
        "sample_size",
        "quantitative_shares",
        "basis_refs",
        "limitations"
      ],
      "properties": {
        "claim_level": {"enum": ["corpus_only", "qualitative_regional", "quantified_regional"]},
        "denominator_status": {"enum": ["unavailable", "defined"]},
        "unit": {
          "type": ["string", "null"],
          "enum": ["building_count", "permit_count", "inventory_count", null]
        },
        "sample_size": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "quantitative_shares": {
          "type": "array",
          "items": {"$ref": "#/$defs/quantitative_share"},
          "uniqueItems": true
        },
        "basis_refs": {"$ref": "#/$defs/basis_refs"},
        "limitations": {"type": "string", "minLength": 10}
      }
    },
    "family_diversity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "minimum_candidate_count", "basis_refs", "limitations"],
      "properties": {
        "status": {"enum": ["single_supported_candidate", "multiple_supported_candidates", "not_established"]},
        "minimum_candidate_count": {"type": "integer", "minimum": 1},
        "basis_refs": {"$ref": "#/$defs/basis_refs"},
        "limitations": {"type": "string", "minLength": 10}
      }
    },
    "family_rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/family_rule"},
      "minItems": 1,
      "uniqueItems": true
    },
    "deferred_features": {
      "type": "array",
      "items": {"$ref": "#/$defs/deferred_feature"},
      "uniqueItems": true
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "statements"],
      "properties": {
        "sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/source"},
          "uniqueItems": true
        },
        "statements": {
          "type": "array",
          "items": {"$ref": "#/$defs/statement"},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 10},
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_code", "subdivision_code", "locality_code_system", "locality_code"],
      "properties": {
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "subdivision_code": {"type": ["string", "null"], "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"},
        "locality_code_system": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,39}$"},
        "locality_code": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{1,19}$"}
      }
    },
    "nonempty_strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "basis_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^KB_[A-Z0-9_]+$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "diagnostic_codes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
      "uniqueItems": true
    },
    "quantitative_share": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "share", "basis_refs"],
      "properties": {
        "family_id": {"type": "string", "pattern": "^FAM_[A-Z0-9_]+$"},
        "share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "basis_refs": {"$ref": "#/$defs/basis_refs"}
      }
    },
    "family_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "disposition", "relationship", "basis_refs", "reason"],
      "properties": {
        "family_id": {"type": "string", "pattern": "^FAM_[A-Z0-9_]+$"},
        "disposition": {"enum": ["eligible", "excluded"]},
        "relationship": {"enum": ["supported_candidate", "explicit_counterexample"]},
        "basis_refs": {"$ref": "#/$defs/basis_refs"},
        "reason": {"type": "string", "minLength": 10}
      }
    },
    "deferred_feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "target_kind",
        "slot_codes",
        "candidate_tags_any",
        "candidate_capabilities_all",
        "basis_refs",
        "gap_code",
        "reason"
      ],
      "properties": {
        "feature_id": {"type": "string", "pattern": "^RCPDEFER_[A-Z0-9_]+$"},
        "target_kind": {"enum": ["module", "material"]},
        "slot_codes": {
          "type": "array",
          "items": {"enum": ["FND", "STR", "WAL", "FAC", "ROF", "DOR", "WIN", "BAL", "VCR", "HCR", "CLM", "BND", "PRK", "SGN", "ORN", "TEC"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "candidate_tags_any": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "candidate_capabilities_all": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "uniqueItems": true
        },
        "basis_refs": {"$ref": "#/$defs/basis_refs"},
        "gap_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "reason": {"type": "string", "minLength": 10}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "title", "authors", "publisher", "year", "url", "accessed_on"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC_[A-Z0-9_]+$"},
        "source_type": {"enum": ["academic_article", "academic_book", "official_statistical_record", "municipal_document", "heritage_register", "primary_document"]},
        "title": {"type": "string", "minLength": 5},
        "authors": {
          "type": "array",
          "items": {"type": "string", "minLength": 2},
          "minItems": 1,
          "uniqueItems": true
        },
        "publisher": {"type": "string", "minLength": 2},
        "year": {"type": "integer", "minimum": 1400, "maximum": 2100},
        "url": {"type": "string", "pattern": "^https://"},
        "accessed_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement_id", "kind", "text", "source_ids", "limitations"],
      "properties": {
        "statement_id": {"type": "string", "pattern": "^KB_[A-Z0-9_]+$"},
        "kind": {"enum": ["evidence", "design_hypothesis"]},
        "text": {"type": "string", "minLength": 20},
        "source_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^SRC_[A-Z0-9_]+$"},
          "uniqueItems": true
        },
        "limitations": {"type": "string", "minLength": 10}
      }
    }
  }
}
