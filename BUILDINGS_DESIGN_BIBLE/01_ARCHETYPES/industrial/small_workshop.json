  "invariants": [
    {
      "invariant_id": "INV_IND_WORKSHOP_SERVICE_DOOR",
      "statement": "Existe ao menos uma abertura de carga dimensionada para equipamento ou veículo.",
      "target": "components.doors",
      "test": "any(door.type in ['industrial','garage','rolling_shutter','sliding'])",
      "violation_action": "reject"
    },
    {
      "invariant_id": "INV_IND_WORKSHOP_CLEAR_SPAN",
      "statement": "O espaço de trabalho principal e um vão livre sem subdivisão permanente.",
      "target": "morphology.structural_span",
      "test": "morphology.structural_span.min >= 3.0",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_IND_WORKSHOP_NO_STACKED_UNITS",
      "statement": "Não há unidades de ocupação empilhadas.",
      "target": "identity.unit_stacking",
      "test": "identity.unit_stacking == 'forbidden'",
      "violation_action": "reject_or_reclassify"
    }
  ],
