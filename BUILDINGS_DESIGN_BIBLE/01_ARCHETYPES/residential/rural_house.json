{
  "schema_version": "0.1",
  "archetype_id": "BLD_RES_HOUSE_RURAL",
  "display_name": "Rural House",
  "description": "Habitação unifamiliar isolada em contexto rural, associada a terreno amplo e a anexos de servico ou producao.",
  "status": "hypothesis",
  "references": {
    "bdb001_archetype": "rural_house",
    "bdb001_section": "8.1 / 15"
  },
  "usage": {
    "primary": "residential",
    "secondary": [
      "agricultural"
    ],
    "subtype": "single_family",
    "typical_occupancy": [
      "private",
      "seasonal"
    ]
  },
  "identity": {
    "volume_types": [
      "detached",
      "cluster",
      "compound"
    ],
    "party_walls": "forbidden",
    "independent_street_access": "required",
    "unit_count": {
      "min": 1,
      "max": 2,
      "preferred": [
        1,
        1
      ]
    },
    "unit_stacking": "forbidden",
    "public_ground_floor": "forbidden"
  },
  "invariants": [
    {
      "invariant_id": "INV_RES_RURAL_NO_PARTY_WALL",
      "statement": "O volume principal permanece isolado, sem parede compartilhada.",
      "target": "identity.party_walls",
      "test": "identity.party_walls == 'forbidden'",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_RES_RURAL_LOW_COVERAGE",
      "statement": "A taxa de ocupação do lote permanece baixa em relação a área disponivel.",
      "target": "lot_relationship.lot_coverage",
      "test": "lot_relationship.lot_coverage.max <= 0.4",
      "violation_action": "warn"
    },
    {
      "invariant_id": "INV_RES_RURAL_OWN_ACCESS",
      "statement": "O acesso ocorre diretamente pelo terreno, sem circulação coletiva.",
      "target": "identity.independent_street_access",
      "test": "identity.independent_street_access == 'required'",
      "violation_action": "reject"
    }
  ],
