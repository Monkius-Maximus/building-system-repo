      "invariant_id": "INV_RES_ATTACHED_PARTY_WALL",
      "statement": "A unidade compartilha ao menos uma parede com uma unidade vizinha.",
      "target": "identity.party_walls",
      "test": "identity.party_walls == 'required'",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_RES_ATTACHED_OWN_STREET_DOOR",
      "statement": "Cada unidade mantem porta própria para o logradouro, sem hall coletivo.",
      "target": "identity.independent_street_access",
      "test": "identity.independent_street_access == 'required'",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_RES_ATTACHED_SINGLE_UNIT",
      "statement": "Cada volume corresponde a uma única unidade de ocupação.",
      "target": "identity.unit_count",
      "test": "identity.unit_count.max == 1",
      "violation_action": "reject_or_reclassify"
    }
  ],
