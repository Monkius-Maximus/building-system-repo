{
  "schema_version": "0.1",
  "archetype_id": "BLD_RES_APARTMENT_MIDRISE",
  "display_name": "Mid-rise Apartment",
  "description": "Habitação multifamiliar de altura média, com núcleo de circulação vertical mecanizado e unidades repetidas por pavimento.",
  "status": "hypothesis",
  "references": {
    "bdb001_archetype": "courtyard_apartment / residential_slab",
    "bdb001_section": "8.1 / 15"
  },
  "usage": {
    "primary": "residential",
    "secondary": [],
    "subtype": "multifamily",
    "typical_occupancy": [
      "private",
      "shared"
    ]
  },
  "identity": {
    "volume_types": [
      "slab",
      "tower",
      "perimeter_block",
      "attached",
      "podium_tower",
      "detached",
      "courtyard",
      "linear"
    ],
    "party_walls": "optional",
    "independent_street_access": "required",
    "unit_count": {
      "min": 8,
      "max": 120,
      "preferred": [
        20,
        60
      ]
    },
    "unit_stacking": "required",
    "public_ground_floor": "optional"
  },
  "invariants": [
    {
      "invariant_id": "INV_RES_MIDRISE_STACKED_UNITS",
      "statement": "As unidades de ocupação estao empilhadas verticalmente e repetidas por pavimento.",
      "target": "identity.unit_stacking",
      "test": "identity.unit_stacking == 'required'",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_RES_MIDRISE_MECHANICAL_CIRCULATION",
      "statement": "A altura exige circulação vertical mecanizada além da escada.",
      "target": "slots.required",
      "test": "'VCR' in slots.required",
      "violation_action": "reject"
    },
    {
      "invariant_id": "INV_RES_MIDRISE_HEIGHT_BAND",
      "statement": "A altura permanece na faixa média definida pelo BDB-001.",
      "target": "morphology.floor_count",
      "test": "5 <= morphology.floor_count.max <= 10",
      "violation_action": "reject_or_reclassify"
    }
  ],
