  "archetype_id": "BLD_RES_HOUSE_DETACHED",
  "display_name": "Detached House",
  "description": "Habitação unifamiliar em volume isolado, sem parede compartilhada com vizinhos e com acesso próprio ao lote.",
  "status": "hypothesis",
  "references": {
    "bdb001_archetype": "detached_house",
    "bdb001_section": "8.1 / 15"
  },
  "usage": {
    "primary": "residential",
    "secondary": [],
    "subtype": "single_family",
    "typical_occupancy": [
      "private"
    ]
  },
  "identity": {
    "volume_types": [
      "detached"
    ],
    "party_walls": "forbidden",
    "independent_street_access": "required",
    "unit_count": {
      "min": 1,
      "max": 1,
      "preferred": [
        1,
        1
      ]
    },
    "unit_stacking": "forbidden",
    "public_ground_floor": "forbidden"
  },
  "invariants": [
    {
      "invariant_id": "INV_RES_DETACHED_NO_PARTY_WALL",
      "statement": "O volume principal não compartilha parede estrutural com edifícios vizinhos.",
      "target": "identity.party_walls",
      "test": "identity.party_walls == 'forbidden'",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_RES_DETACHED_SINGLE_UNIT",
      "statement": "O edifício abriga uma única unidade de ocupação independente.",
      "target": "identity.unit_count",
      "test": "identity.unit_count.max == 1",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_RES_DETACHED_OWN_ACCESS",
      "statement": "A unidade possui acesso próprio a partir do logradouro ou do lote.",
      "target": "identity.independent_street_access",
      "test": "identity.independent_street_access == 'required'",
      "violation_action": "reject"
    }
  ],
