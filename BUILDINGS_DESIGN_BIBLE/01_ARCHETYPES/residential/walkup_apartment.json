{
  "schema_version": "0.1",
  "archetype_id": "BLD_RES_APARTMENT_WALKUP",
  "display_name": "Walk-up Apartment",
  "description": "Habitação multifamiliar de poucos pavimentos, com unidades empilhadas servidas exclusivamente por escada.",
  "status": "hypothesis",
  "references": {
    "bdb001_archetype": "walkup_apartment",
    "bdb001_section": "8.1 / 15"
  },
  "usage": {
    "primary": "residential",
    "secondary": [],
    "subtype": "multifamily",
    "typical_occupancy": [
      "private",
      "shared"
    ]
  },
  "identity": {
    "volume_types": [
      "detached",
      "attached",
      "row",
      "slab",
      "perimeter_block",
      "linear"
    ],
    "party_walls": "optional",
    "independent_street_access": "required",
    "unit_count": {
      "min": 3,
      "max": 24,
      "preferred": [
        4,
        12
      ]
    },
    "unit_stacking": "required",
    "public_ground_floor": "optional"
  },
  "invariants": [
    {
      "invariant_id": "INV_RES_WALKUP_STACKED_UNITS",
      "statement": "As unidades de ocupação estao empilhadas verticalmente.",
      "target": "identity.unit_stacking",
      "test": "identity.unit_stacking == 'required'",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_RES_WALKUP_STAIR_SERVED",
      "statement": "Todas as unidades são alcançáveis por escada, sem depender de elevador.",
      "target": "morphology.floor_count",
      "test": "morphology.floor_count.max <= 5",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_RES_WALKUP_SHARED_CIRCULATION",
      "statement": "Existe circulação vertical coletiva servindo as unidades.",
      "target": "slots.required",
      "test": "'VCR' in slots.required",
      "violation_action": "reject"
    }
  ],
