  "invariants": [
    {
      "invariant_id": "INV_COM_CORNER_TWO_FRONTAGES",
      "statement": "A unidade possui ao menos duas testadas voltadas para logradouro.",
      "target": "lot_relationship.street_frontages",
      "test": "lot_relationship.street_frontages.min >= 2",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_COM_CORNER_LOT",
      "statement": "A implantação exige lote de esquina.",
      "target": "lot_relationship.requires_corner_lot",
      "test": "lot_relationship.requires_corner_lot == true",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_COM_CORNER_PUBLIC_GROUND_FLOOR",
      "statement": "O pavimento térreo e acessível ao público diretamente pelo logradouro.",
      "target": "identity.public_ground_floor",
      "test": "identity.public_ground_floor == 'required'",
      "violation_action": "reject"
    }
  ],
