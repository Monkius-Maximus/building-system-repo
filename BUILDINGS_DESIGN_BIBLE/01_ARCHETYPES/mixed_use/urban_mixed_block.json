{
  "schema_version": "0.1",
  "archetype_id": "BLD_MIX_URBAN_BLOCK",
  "display_name": "Urban Mixed Block",
  "description": "Bloco urbano de uso misto, com base comercial ativa e pavimentos superiores residenciais ou de escritório.",
  "status": "hypothesis",
  "references": {
    "bdb001_archetype": "mixed_use_block",
    "bdb001_section": "8.3 / 15"
  },
  "usage": {
    "primary": "mixed_use",
    "secondary": [
      "commercial",
      "residential"
    ],
    "subtype": "mixed_use_block",
    "typical_occupancy": [
      "private",
      "public",
      "shared"
    ]
  },
  "identity": {
    "volume_types": [
      "perimeter_block",
      "slab",
      "attached",
      "podium_tower",
      "courtyard",
      "linear"
    ],
    "party_walls": "optional",
    "independent_street_access": "required",
    "unit_count": {
      "min": 10,
      "max": 200,
      "preferred": [
        20,
        80
      ]
    },
    "unit_stacking": "required",
    "public_ground_floor": "required",
    "vertical_use_stack": [
      "commercial",
      "residential"
    ]
  },
  "invariants": [
    {
      "invariant_id": "INV_MIX_BLOCK_ACTIVE_BASE",
      "statement": "A base do edifício mantem uso público ativo voltado ao logradouro.",
      "target": "identity.public_ground_floor",
      "test": "identity.public_ground_floor == 'required'",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_MIX_BLOCK_USE_STACK",
      "statement": "Existe separação vertical entre a base de uso público e os pavimentos superiores.",
      "target": "identity.vertical_use_stack",
      "test": "len(identity.vertical_use_stack) >= 2",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_MIX_BLOCK_SHARED_CIRCULATION",
      "statement": "Os usos superiores dependem de circulação vertical coletiva própria.",
      "target": "slots.required",
      "test": "'VCR' in slots.required",
      "violation_action": "reject"
    }
  ],
  "morphology": {
    "floor_count": {
      "min": 3,
      "max": 12,
      "preferred": [
        4,
