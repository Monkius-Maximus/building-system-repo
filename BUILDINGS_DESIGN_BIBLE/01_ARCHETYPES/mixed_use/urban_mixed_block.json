  "archetype_escalation": [
    {
      "condition": "morphology.floor_count > 12",
      "suggested_archetype": "BLD_MIX_TOWER",
      "note": "Acima da faixa definida o edifício passa a operar como torre de uso misto."
    },
    {
      "condition": "morphology.floor_count < 3",
      "suggested_archetype": "BLD_MIX_SHOP_HOUSE",
      "note": "Em porte reduzido a tipologia de sobrado comercial descreve melhor o edifício."
    },
    {
      "condition": "base deixa de ser publica",
      "suggested_archetype": "BLD_RES_APARTMENT_MIDRISE",
      "note": "Sem base ativa o edifício deixa de ser misto."
    }
  ]
