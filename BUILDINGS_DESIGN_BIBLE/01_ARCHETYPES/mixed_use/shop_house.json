  "invariants": [
    {
      "invariant_id": "INV_MIX_SHOPHOUSE_USE_STACK",
      "statement": "O uso comercial ocupa o térreo e o uso residencial ocupa os pavimentos superiores.",
      "target": "identity.vertical_use_stack",
      "test": "identity.vertical_use_stack == ['commercial','residential']",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_MIX_SHOPHOUSE_SEPARATE_ACCESS",
      "statement": "Comercio e moradia possuem acessos distintos a partir do logradouro.",
      "target": "identity.independent_street_access",
      "test": "identity.independent_street_access == 'required'",
      "violation_action": "reject"
    },
    {
      "invariant_id": "INV_MIX_SHOPHOUSE_PUBLIC_GROUND_FLOOR",
      "statement": "O térreo permanece acessível ao público.",
      "target": "identity.public_ground_floor",
      "test": "identity.public_ground_floor == 'required'",
      "violation_action": "reject_or_reclassify"
    }
  ],
