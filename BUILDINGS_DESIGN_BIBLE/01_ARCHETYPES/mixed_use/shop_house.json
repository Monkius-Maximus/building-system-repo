  "archetype_id": "BLD_MIX_SHOP_HOUSE",
  "display_name": "Shop House",
  "description": "Edifício de uso misto de pequeno porte, com comércio no térreo e moradia nos pavimentos superiores, sob uma mesma estrutura.",
  "status": "hypothesis",
  "references": {
    "bdb001_archetype": "shop_house",
    "bdb001_section": "8.3 / 15"
  },
