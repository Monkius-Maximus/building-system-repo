      "min": 1,
      "max": 1,
      "preferred": [
        1,
        1
      ]
    },
    "unit_stacking": "required",
    "public_ground_floor": "required",
    "barrier_free_entrance": "required"
  },
  "invariants": [
    {
      "invariant_id": "INV_INS_HOSPITAL_ACCESSIBLE_ENTRANCE",
      "statement": "O acesso público principal deve ser livre de barreiras.",
      "target": "identity.barrier_free_entrance",
      "test": "identity.barrier_free_entrance == 'required'",
      "violation_action": "reject"
    },
    {
      "invariant_id": "INV_INS_HOSPITAL_SEPARATED_CIRCULATION",
      "statement": "O programa exige circulação interna definida para separar fluxos de atendimento, pacientes e apoio.",
      "target": "slots.required",
      "test": "'HCR' in slots.required",
      "violation_action": "reject"
    },
    {
      "invariant_id": "INV_INS_HOSPITAL_TECHNICAL_INFRASTRUCTURE",
      "statement": "O edifício depende de infraestrutura técnica própria e contínua.",
      "target": "slots.required",
      "test": "'TEC' in slots.required",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_INS_HOSPITAL_PROGRAMMATIC_SCALE",
      "statement": "A organização deve comportar múltiplos setores funcionais em vez de um único ambiente de atendimento.",
      "target": "morphology.volume_complexity",
      "test": "'composite' in morphology.volume_complexity.allowed or 'segmented' in morphology.volume_complexity.allowed",
      "violation_action": "reject"
    }
  ],
