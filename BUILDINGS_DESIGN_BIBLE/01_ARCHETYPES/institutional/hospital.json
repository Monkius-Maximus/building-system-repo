      "public",
      "restricted"
    ]
  },
  "identity": {
    "volume_types": [
      "detached",
      "attached",
      "courtyard",
      "slab",
      "pavilion",
      "linear",
      "cluster",
      "compound"
    ],
    "party_walls": "optional",
