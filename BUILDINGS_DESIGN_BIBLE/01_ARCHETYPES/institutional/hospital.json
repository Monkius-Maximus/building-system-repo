  "display_name": "Hospital",
  "description": "Equipamento de saúde de porte médio ou grande, com programa setorizado, circulação diferenciada, infraestrutura técnica contínua e possibilidade de atendimento e permanência de pacientes.",
  "status": "hypothesis",
  "references": {
    "bdb001_archetype": "hospital",
    "bdb001_section": "8.4 / 15",
    "notes": "Primeira ficha específica derivada da lacuna morfológica identificada em BDB-003-C."
  },
  "usage": {
    "primary": "institutional",
    "secondary": [
      "civic"
    ],
    "subtype": "healthcare_hospital",
