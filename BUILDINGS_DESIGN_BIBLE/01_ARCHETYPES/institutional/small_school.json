  "display_name": "Small School",
  "description": "Equipamento educacional de pequeno porte, organizado em blocos ou pavilhões com circulação coletiva e pátio próprio.",
  "status": "hypothesis",
  "references": {
    "bdb001_archetype": "school",
    "bdb001_section": "8.4 / 15"
  },
