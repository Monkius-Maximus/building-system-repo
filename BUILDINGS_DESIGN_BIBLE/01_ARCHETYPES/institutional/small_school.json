    "primary": "institutional",
    "secondary": [
      "civic"
    ],
    "subtype": "education",
    "typical_occupancy": [
      "public",
      "restricted"
    ]
  },
  "identity": {
    "volume_types": [
      "pavilion",
      "cluster",
      "detached",
      "courtyard",
      "linear",
      "attached"
    ],
    "party_walls": "optional",
    "independent_street_access": "required",
    "unit_count": {
      "min": 1,
      "max": 1,
