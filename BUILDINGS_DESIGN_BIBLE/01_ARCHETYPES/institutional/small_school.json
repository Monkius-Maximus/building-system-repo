    "unit_stacking": "forbidden",
    "public_ground_floor": "required",
    "barrier_free_entrance": "required"
  },
  "invariants": [
    {
      "invariant_id": "INV_INS_SCHOOL_COLLECTIVE_CIRCULATION",
      "statement": "As salas dependem de circulação horizontal coletiva.",
      "target": "slots.required",
      "test": "'HCR' in slots.required",
      "violation_action": "reject"
    },
    {
      "invariant_id": "INV_INS_SCHOOL_CONTROLLED_PERIMETER",
      "statement": "O conjunto possui perímetro delimitado e acesso controlado.",
      "target": "slots.required",
      "test": "'BND' in slots.required",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_INS_SCHOOL_OUTDOOR_AREA",
      "statement": "O programa exige área externa coletiva própria.",
      "target": "lot_relationship.required_external_spaces",
      "test": "len(lot_relationship.required_external_spaces) >= 1",
      "violation_action": "reject_or_reclassify"
    },
    {
      "invariant_id": "INV_INS_SCHOOL_ACCESSIBLE_ENTRANCE",
      "statement": "O acesso principal é livre de barreiras.",
      "target": "identity.barrier_free_entrance",
      "test": "identity.barrier_free_entrance == 'required'",
      "violation_action": "reject"
    }
  ],
