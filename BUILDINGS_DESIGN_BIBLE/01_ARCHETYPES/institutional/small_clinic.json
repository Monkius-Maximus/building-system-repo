      "invariant_id": "INV_INS_CLINIC_ACCESSIBLE_ENTRANCE",
      "statement": "O acesso público principal é livre de barreiras.",
      "target": "identity.barrier_free_entrance",
      "test": "identity.barrier_free_entrance == 'required'",
      "violation_action": "reject"
    },
    {
      "invariant_id": "INV_INS_CLINIC_INTERNAL_CIRCULATION",
      "statement": "O programa exige circulação interna que separe espera e atendimento.",
      "target": "slots.required",
      "test": "'HCR' in slots.required",
      "violation_action": "reject"
    },
    {
      "invariant_id": "INV_INS_CLINIC_TECHNICAL_SUPPORT",
      "statement": "O edifício depende de infraestrutura tecnica própria.",
      "target": "slots.required",
      "test": "'TEC' in slots.required",
      "violation_action": "reject_or_reclassify"
    }
